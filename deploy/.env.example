# 复制为 .env 使用（放在 docker-compose.yml 同目录）
#   cp deploy/.env.example deploy/.env && chmod 600 deploy/.env

# 镜像地址。想回滚到某个提交：joe1280/meowmusic:sha-<短提交>
MEOW_IMAGE=joe1280/meowmusic:latest

# 对外端口
MEOW_PORT=2233

# 数据目录（歌单/用户/设备绑定/音频缓存），放大盘，别放根分区
MEOW_DATA_DIR=/vol1/meowmusic/data

# 设备专用歌单接口单次最多下发多少首（大歌单会被设备端截断）
PLAYLIST_SONGS_MAX=150

# mp3api 外部源（YouTube 曲库）密钥，用于播放国内下架歌曲
MUSIC_MP3API_KEY=

# 可选：音源开关 / 模式 / 站点信息
# MUSIC_SOURCES=kuwo,netease,qq,kugou,gdstudio,mp3api
# MUSIC_SOURCE_MODE=auto
# MUSIC_MP3API_BASE=https://mp3.994938.xyz/api/music
# WEBSITE_NAME_CN=喵喵音乐

# 喜马拉雅（有声书/播客）补充源：只在「喜马拉雅」筛选下出现，0 = 关闭
# XIMALAYA_ENABLED=1

# 5sing（原创/翻唱）补充源：只在「5sing」筛选下出现，0 = 关闭
# FIVESING_ENABLED=1
