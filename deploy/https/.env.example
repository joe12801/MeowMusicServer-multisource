# 复制为 .env 后按需修改（这个文件不要提交真实域名/Token）
#
# 你的域名（DNS A 记录要指向这台机器的公网 IP）
MEOW_DOMAIN=music.example.com
# Let's Encrypt 通知邮箱（可留空）
MEOW_ACME_EMAIL=
# 宿主机对外暴露的 HTTPS 端口（80/443 被占用时用 8443）
MEOW_HTTPS_PORT=8443
# 上游：同网络时用容器名，不同网络时改成 host.docker.internal:2233 或 宿主机IP:2233
MEOW_UPSTREAM=meow-music:2233
# meow-music 所在的 docker 网络名（docker network ls 里查，默认 <项目名>_default）
MEOW_NETWORK=meowmusic_default
# 走 DNS-01 时才需要（Cloudflare Token）
CF_API_TOKEN=
